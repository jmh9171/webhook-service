# Production configuration only. The local replay URL is saved in your browser.
NODE_ENV=production
PORT=3000
ADMIN_USER=owner
# Set privately before deployment; do not commit actual values.
ADMIN_PASSWORD=
CAPTURE_TOKEN=

# Optional server-only Signal project key. Missing/blank disables analytics.
# Never use a VITE_ prefix or put this key in browser code.
SIGNAL_API_KEY=

# Optional browser analytics. Both values are required; otherwise silent no-op.
# Public build-time config. Use ONLY the project's pk_ browser key here.
VITE_ANALYTICS_URL=https://clonalytics-staging-kpjmx.sevalla.app
# Owner's public browser-key variable (Vite maps only this exact alias).
SIGNAL_API_KEY_FRONTEND=
# Optional equivalent; when set, takes precedence over SIGNAL_API_KEY_FRONTEND.
VITE_ANALYTICS_KEY=

